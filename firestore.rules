rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isValidId(userId));
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;
    }

    // Rooms
    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(roomId);
      allow update: if isSignedIn() && isValidId(roomId);
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      // Room members
      match /members/{memberId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == memberId;
        allow delete: if isSignedIn() && (request.auth.uid == memberId || get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid);
      }

      // Room shared pins
      match /pins/{pinId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.pinnedByUserId == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() && (resource.data.pinnedByUserId == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid);
      }

      // Room accusation votes
      match /votes/{voterId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == voterId;
        allow delete: if false;
      }
    }
  }
}
